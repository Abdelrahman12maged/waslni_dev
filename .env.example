# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and configure your variables before running:
# cp .env.example .env
# ==============================================================================

# Backend API Base URL
BASE_URL=https://your-api-domain.com/

# Google Maps Platform API Key (Used for Maps SDK, Places API, Directions API)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Contact info (Optional)
COMPANY_WEBSITE=https://your-company-domain.com/
SUPPORT_EMAIL=support@your-company-domain.com
